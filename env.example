# MercadoPago Configuration
MP_ACCESS_TOKEN=your_mercadopago_access_token_here

# Base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Supabase Configuration (if needed)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firma de los links de reseña (?t=) que marcan "Compra verificada".
# Opcional: si falta, se usa SUPABASE_JWT_SECRET. Si no hay ninguno de los dos,
# las reseñas se siguen guardando pero nunca quedan como compra verificada.
REVIEW_TOKEN_SECRET=una_cadena_larga_y_aleatoria

# Cloudflare R2 Configuration (if needed)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Public base URL for R2 (sin barra al final)
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-<account>.r2.dev/<bucket>
# O dominio custom (ejemplo)
# NEXT_PUBLIC_R2_PUBLIC_BASE=https://cdn.novamente.ar

# Meta Pixel Configuration
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1449108482474160
